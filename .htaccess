# Block direct access to sensitive/non-web files (dotfiles like .env, and backup/dump extensions)
<FilesMatch "(^\.|\.sql$|\.rar$|\.zip$|\.bak$|\.log$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Backwards-compatibility routing for the folder restructure.
#
# Historically every page lived at the web root (e.g. /Stock_LS/stock.php).
# They now live in pages/, api/ and export/. These rules keep every old
# flat URL working - bookmarks, printed QR codes, and any inter-page link
# we did not rewrite - by transparently locating the file in a subfolder.
#
# DEPLOY NOTE: the base path below is "/Stock_LS/" (XAMPP dev). If this app
# is served from the domain root in production, change RewriteBase to "/"
# and the two "/Stock_LS/" prefixes in the last rule to "/".
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Stock_LS/

    # 1) Flat legacy URL -> real location in pages/ | api/ | export/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/Stock_LS/pages/$1 -f
    RewriteRule ^([A-Za-z0-9._-]+\.php)$ pages/$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/Stock_LS/api/$1 -f
    RewriteRule ^([A-Za-z0-9._-]+\.php)$ api/$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/Stock_LS/export/$1 -f
    RewriteRule ^([A-Za-z0-9._-]+\.php)$ export/$1 [L,QSA]

    # 2) A relative .php link/redirect emitted from inside a subfolder
    #    (e.g. pages/x.php links to "allstock.php" -> pages/allstock.php, or
    #    sends "Location: index.php" -> pages/index.php). Bounce back to the
    #    app root so rule 1 can re-dispatch it.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(?:pages|api|export)/([A-Za-z0-9._-]+\.php)$ /Stock_LS/$1 [L,QSA]

    # 3) A relative ASSET reference from a moved page resolves against the
    #    page's folder (e.g. pages/stock.php -> pages/image/x.png,
    #    pages/css/styles.css, pages/picture/uploads/y.jpg). Send those to
    #    the real asset folder at the app root.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(?:pages|api|export)/((?:image|img|images|css|js|picture|uploads|fonts|assets)/.+)$ /Stock_LS/$1 [L,QSA]
</IfModule>
